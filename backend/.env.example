MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
PORT=8000

# Metered TURN (WebRTC relay for cross-network calls).
# Both are server-side only and must never be exposed to the browser.
# Without them the app still runs, but falls back to STUN-only, so calls
# between peers on different networks (e.g. Wi-Fi to cellular) will fail.
METERED_DOMAIN=yourappname.metered.live
METERED_SECRET_KEY=your_metered_secret_key
